        <img src="https://cdn.akamai.steamstatic.com/steam/apps/255710/header.jpg" alt="">
        <h1>Cities: Skylines</h1>
        <span class="fav-cta">View on Steam</span>
      </div>
      <div class="fav" data-href="https://store.steampowered.com/app/233450/Prison_Architect/">
        <a href="https://store.steampowered.com/app/233450/Prison_Architect/" target="_blank" class="ricon">
          <img src="https://store.steampowered.com/favicon.ico" alt="View on Steam">
        </a>
        <img src="https://cdn.akamai.steamstatic.com/steam/apps/233450/header.jpg" alt="">
        <h1>Prison Architect</h1>
        <span class="fav-cta">View on Steam</span>
      </div>
    </div>
  </section>
</div>
<div style="display:none;">
  <a class="u-url p-name" href="{{ output }}">{{ title }}</a>
  <div class="p-author h-card">
    <a class="u-url n" href="https://flench.me">Flench04</a>
  </div>
</div>
<script>
  window.addEventListener("load", function() {
    const grid = document.getElementById("year-favorites-grid");

    if (!grid) {
      return;
    }

    const items = Array.from(grid.children).filter((item) => item.classList.contains("fav"));

    if (items.length > 1) {
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }

      grid.innerHTML = "";
      items.forEach((item) => grid.appendChild(item));
    }

    if (items.length > 0) {
      grid.style.visibility = "visible";
    }

    grid.querySelectorAll(".fav[data-href]").forEach((card) => {
      const href = card.dataset.href;
      if (!href) return;

      card.addEventListener("click", (event) => {
        if (event.target.closest("a")) return;
        window.open(href, "_blank");
      });

      card.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          window.open(href, "_blank");
        }
      });

      card.setAttribute("role", "link");
      card.setAttribute("tabindex", "0");
    });

    function resizeYearFavorites() {
      grid.style.width = "auto";
      const columns = window.getComputedStyle(grid).gridTemplateColumns.split(" ").filter(Boolean);
      const width = columns.reduce((total, column) => total + parseInt(column, 10), 0);
      if (width > 0) {
        grid.style.width = width + "px";
      }
    }

    resizeYearFavorites();
    window.addEventListener("resize", resizeYearFavorites);
  });
</script>
~{endblock}~
