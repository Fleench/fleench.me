<!-- meta start -->
<!--
extends: src/templates/page.html.temp
-->
<!-- meta end -->

~{block head_extra}~
<link rel="alternate" type="application/rss+xml" title="Site RSS" href="/rss.xml" />
<script src="https://www.youtube.com/iframe_api"></script>
<script src="/js/yt-player.js" defer></script>
<style>
  .year-favorites {
    margin-top: 2rem;
  }

  .year-favorites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, 16em);
    overflow: auto;
    scrollbar-width: none;
    gap: 0;
    margin: 0;
    padding: 0;
    visibility: hidden;
    justify-content: start;
    border-radius: 8px;
  }

  .year-favorites-grid::-webkit-scrollbar {
    display: none;
  }

  .year-favorites .fav {
    position: relative;
    width: 16em;
    margin: 0;
    padding: 0;
    background-size: cover;
    overflow: hidden;
  }

  .year-favorites .fav img {
    object-fit: cover;
    width: 100%;
    height: 15em;
    display: block;
  }

  .year-favorites .fav h1 {
    position: absolute;
    bottom: -0.6em;
    margin-top: -1.9em;
    font-size: clamp(0.5rem, 2vw, 1.35rem);
    text-wrap: auto;
  }

  .year-favorites .fav .ricon {
    position: absolute;
    right: 3px;
    top: 3px;
    z-index: 2;
  }

  .year-favorites .fav[data-href] {
    cursor: pointer;
  }

  .year-favorites .fav .fav-cta {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0;
    transition: opacity 180ms ease-in-out;
    pointer-events: none;
    z-index: 1;
  }

  .year-favorites .fav:hover .fav-cta,
  .year-favorites .fav:focus-visible .fav-cta {
    opacity: 1;
  }

  .year-favorites .ricon img {
    width: auto !important;
    height: 32px !important;
    margin: 0 !important;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
  }

  .year-favorites .ricon:hover {
    transform: scale(1.1);
  }

  .year-review-photo {
    width: min(100%, 30rem);
    margin: 1rem auto;
    padding: 0.5rem;
    background: var(--bg-shade);
    border: 1px solid var(--panel-border);
    box-shadow: 0 2px 0 #e2e6ef;
  }

  .year-review-photo img {
    display: block;
    width: 100%;
    max-height: 24rem;
    object-fit: contain;
  }

  .year-review-photo figcaption {
    margin-top: 0.5rem;
    color: var(--muted-text);
    font-size: 0.9rem;
    line-height: 1.35;
    text-align: center;
  }

  html[data-mode="dark"] .year-review-photo {
    background: #1a1a1a;
    border-color: #333;
    box-shadow: 0 2px 0 #000;
  }

  .year-review-month-left,
  .year-review-month-right {
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    margin: 1.5rem 0;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--panel-border);
  }

  .year-review-month-left > .year-review-photo,
  .year-review-month-right > .year-review-photo {
    width: 100%;
    margin: 0;
  }

  .year-review-month-left > .year-review-photo {
    grid-column: 1;
    grid-row: 1 / span 5;
  }

  .year-review-month-left > :not(.year-review-photo) {
    grid-column: 2;
  }

  .year-review-month-right {
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 18rem);
  }

  .year-review-month-right > .year-review-photo {
    grid-column: 2;
    grid-row: 1 / span 5;
  }

  .year-review-month-right > :not(.year-review-photo) {
    grid-column: 1;
  }

  .year-review-month-left h1,
  .year-review-month-right h1 {
    margin-bottom: 0.5rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
  }

  .year-review-month-left p,
  .year-review-month-right p {
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    line-height: 1.45;
    margin: 0 0 1rem;
  }

  .year-review-month-left h3,
  .year-review-month-right h3 {
    font-size: clamp(1.15rem, 2.6vw, 1.6rem);
    margin: 1rem 0 0.5rem;
  }

  .year-review-month-left li,
  .year-review-month-right li {
    font-size: clamp(1rem, 2.1vw, 1.2rem);
  }

  .year-review-month-left > :not(.year-review-photo),
  .year-review-month-right > :not(.year-review-photo) {
    align-self: stretch;
  }

  @media (max-width: 760px) {
    .year-review-month-left,
    .year-review-month-right {
      display: block;
    }

    .year-review-month-left > .year-review-photo,
    .year-review-month-right > .year-review-photo {
      width: min(100%, 30rem);
      margin: 1rem auto;
    }
  }
</style>
~{endblock}~

~{block content_block}~
