<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <link rel="stylesheet" href="/style.css" />
    <script src="/theme-mode.js" defer></script>
    <link rel="canonical" href="{{ canonical }}" />
    <link rel="alternate" type="application/rss+xml" title="Site RSS" href="/rss.xml" />
    <link rel="webmention" href="https://webmention.io/flench.me/webmention" />
    <link rel="pingback" href="https://webmention.io/flench.me/xmlrpc" />
    <script src="/layout.js" defer></script>
    <script src="/mentions.js" defer></script>
    <link rel="stylesheet" href="https://poempuppy.neocities.org/webring/onionring.css">

</head>
  <body>
    <div class="page-wrap">
      ~{src/.elements/marquee.element}~

      <div class="site-layout">
        <div class="center-column">
          <div class="content-shell">
            ~{src/.elements/nav.element}~
            <button
              class="sidebar-toggle-button panel"
              type="button"
              aria-controls="left-sidebar"
              aria-expanded="false"
              hidden
            >
              Toggle sidebar
            </button>
      
            
            <div class="content-row">
              <aside class="sidebar sidebar-left panel" id="left-sidebar">
                <h2>About</h2>
                <p>This is flench04's personal corner of the web.</p>
                <ul>
                  <li><a href="https://flench.me">flench.me</a></li>
                  <li><a href="/notes/">Latest notes</a></li>
                  <li><a href="/rss.xml">Combined RSS</a></li>
                </ul>

                <h3>Status</h3>
                <p class="blink">Now playing: Ben Rector</p>
<!-- <iframe data-testid="embed-iframe" style="border-radius:12px" src="https://open.spotify.com/embed/artist/4AapPt7H6bGH4i7chTulpI?utm_source=generator" width="100%" height="352" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>-->
                <div class="buttons-row" aria-label="Small site buttons">
                  <span class="button-88x31">HTML</span>
                  <span class="button-88x31">CSS</span>
                  <span class="button-88x31">RSS</span>
                </div>
              </aside>

              <main class="layout h-entry">
                <section class="content panel">
                  <div class="e-content">
                   {{ content }}
<div id='apple-webring' data-apple="red">
    <script type="text/javascript" src="https://poempuppy.neocities.org/webring/onionring-variables.js"></script>
    <script type="text/javascript" src="https://poempuppy.neocities.org/webring/onionring-widget.js"></script>
</div>
                  </div>
                  <div style="display:none;">
                    <a class="u-url p-name" href="/">Home</a>
                    <div class="p-author h-card">
                      <a class="u-url n" href="https://flench.me">Flench04</a>
                    </div>
                  </div>
                </section>

                <section class="main-extras">
                  <div id="webmentions"></div>
                  ~{src/.elements/footer.element}~
                </section>
              </main>
              <aside class="sidebar sidebar-left panel" id="right-sidebar">
              <h1>
              Add my button
              </h1>
              <p>Please copy the code below to add my button</p>
              <a href="https://flench.me"><image src="/theme/button.gif"></image></a>
                  {{ button }}
              </aside>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
