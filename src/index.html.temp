<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="alternate" type="application/rss+xml" title="Site RSS" href="/rss.xml" />
    <script src="/layout.js" defer></script>
    <script src="/mentions.js" defer></script>
  </head>
  <body>
    <div class="page-wrap">
      <header class="marquee-frame panel">
        <marquee behavior="alternate" scrollamount="6">
          ★ Welcome to Retro Pixel Palace ★ Midnight Edition ★
        </marquee>
      </header>

      <div class="site-layout">
        <div class="center-column">
          <div class="content-shell">
            <button
              class="sidebar-toggle-button panel"
              type="button"
              aria-controls="left-sidebar"
              aria-expanded="false"
              hidden
            >
              Toggle sidebar
            </button>

            ~{src/.elements/marquee.element}~

            <div class="content-row">
              <aside class="sidebar sidebar-left panel" id="left-sidebar">
                <h2>About</h2>
                <p>This is Glenn's personal corner of the web.</p>
                <ul>
                  <li><a href="https://flench.me">flench.me</a></li>
                  <li><a href="/notes/">Latest notes</a></li>
                  <li><a href="/rss.xml">Combined RSS</a></li>
                </ul>

                <h3>Status</h3>
                <p class="blink">Now playing: IndieWeb experiments</p>

                <div class="buttons-row" aria-label="Small site buttons">
                  <span class="button-88x31">HTML</span>
                  <span class="button-88x31">CSS</span>
                  <span class="button-88x31">RSS</span>
                </div>
              </aside>

              <main class="layout h-entry">
                <section class="content panel">
                  <h1>Welcome</h1>
                  <div class="e-content">
                    <p>
                      This site is built from simple templates and markdown notes. If you enjoy
                      old-school personal sites, you are in the right place.
                    </p>
                    <p>
                      Check the <a href="/notes/">notes page</a> for short updates and visit the
                      <a href="/rss.xml">RSS feed</a> if you want to follow along.
                    </p>
                    <p>
                      You can also find me on the fediverse via Bridgy Fed as
                      <strong>@flench.me@web.brid.gy</strong>.
                    </p>
                  </div>
                  <div style="display:none;">
                    <a class="u-url p-name" href="/">Home</a>
                    <div class="p-author h-card">
                      <a class="u-url n" href="https://flench.me">Glenn Sutherland</a>
                    </div>
                  </div>
                </section>

                <section class="main-extras">
                  <div id="webmentions"></div>
                  <footer class="panel footer">
                    <p>© 2001 Retro Pixel Palace — E-mail: webmaster@pixelpalace.example</p>
                  </footer>
                </section>
              </main>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
