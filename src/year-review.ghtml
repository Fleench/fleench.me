from gen.html.elements import Element, Page, Text


def CONTEXT(api):
    return {
        "route": "/year-review/",
        "title": "Year Review",
        "canonical": "https://flench.me/year-review/",
    }


def Build(api, context):
    fragment = api["methods"]["fragment"]

    page = Page("html", {"lang": "en"})
    with page:
        Element("head")
        with Element("body"):
            page_wrap = fragment("templates/page")
            page.add_before(page.find("class", "site-layout")[0].uuid, fragment("elements/marquee"))
            with page_wrap:
                fragment("elements/head")
                fragment("elements/nav")
                template = fragment("templates/year-review-redirect")
                for head_extra in template.find("id", "head_extra"):
                    for child in list(head_extra.children):
                        head_extra.children.remove(child)
                        child.parent = None
                        child.attrs["gHoist"] = "head"
                        template.add(child)
                    head_extra.parent.children.remove(head_extra)
                template.find("id", "content_block")[0].attrs["gHoist"] = "ContentPanel"
                api["methods"]["foot"]()
                page.find("tag", "title")[0].add(Text(context["title"]))
                page.find("id", "Canonical")[0].attrs["href"] = context["canonical"]
    return page


def main():
    from gen.ssg.dispatcher import GenSSGDispatcher

    dispatcher = GenSSGDispatcher()
    api = dispatcher.create_api()
    print(dispatcher.build_page(api, __import__(__name__), CONTEXT(api)))


if __name__ == "__main__":
    main()
