from gen.html.elements import Element, Page, Text


BODY = """# HI THERE
### Test Ping
I am testing my [homepage](https://flench.me/)

And now my blog [test page](https://flench.me/blogs/test/)
But I think it is [broken](https://flench.me/blogs/test)

## Local storage status

<p><strong>Pages visited:</strong></p>
<ol id="visited-pages-list"></ol>

<script>
(function () {
  const VISITS_STORAGE_KEY = 'flench.pageVisits';
  const visitsEl = document.getElementById('visited-pages-list');

  if (!visitsEl) {
    return;
  }

  let visits = [];
  try {
    const parsed = JSON.parse(localStorage.getItem(VISITS_STORAGE_KEY) || '[]');
    if (Array.isArray(parsed)) {
      visits = parsed;
    }
  } catch (_error) {
    visits = [];
  }

  if (visits.length === 0) {
    const item = document.createElement('li');
    item.textContent = 'No visits saved yet.';
    visitsEl.appendChild(item);
    return;
  }

  visits
    .slice()
    .reverse()
    .forEach((visit) => {
      const item = document.createElement('li');
      const visitUrl = typeof visit.url === 'string' ? visit.url : '(unknown url)';
      const visitedAt = typeof visit.visitedAt === 'string' ? visit.visitedAt : '(unknown time)';
      item.textContent = `${visitUrl} - ${visitedAt}`;
      visitsEl.appendChild(item);
    });
})();
</script>

# BOO ---test_output---{}---UP
Yo this is at the bottom
# HI ---left-sidebar
![](/profile.png)"""


def CONTEXT(api):
    return {
        "cache": {"mode": "templates", "templates": ["elements/head", "elements/marquee", "elements/nav", "elements/footer", "templates/page", "templates/test"]},
        "route": "/test/",
        "title": "Test",
        "canonical": "https://flench.me/test/",
    }


def Build(api, context):
    fragment = api["methods"]["fragment"]
    gen_md = api["methods"]["genMD"]
    blocks = gen_md(BODY, ghoist="TestContent")

    page = Page("html", {"lang": "en"})
    with page:
        Element("head")
        with Element("body"):
            page_wrap = fragment("templates/page")
            page.add_before(page.find("class", "site-layout")[0].uuid, fragment("elements/marquee"))
            with page_wrap:
                fragment("elements/head")
                fragment("elements/nav")
                template = fragment("templates/test")
                for head_extra in template.find("id", "head_extra"):
                    for child in list(head_extra.children):
                        head_extra.children.remove(child)
                        child.parent = None
                        child.attrs["gHoist"] = "head"
                        template.add(child)
                    head_extra.parent.children.remove(head_extra)
                template.find("id", "left_sidebar")[0].attrs["gHoist"] = "left-sidebar"
                template.find("id", "content_block")[0].attrs["gHoist"] = "ContentPanel"
                template.find("id", "Content")[0].attrs["id"] = "TestContent"
                template.find("id", "test_output")[0].attrs["gHoist"] = "ContentPanel"
                for block in blocks:
                    page_wrap.add(block)
                with Element("div", {"style": "display:none;"}):
                    api["methods"]["foot"]()
                with page.find("tag", "title")[0]:
                    Text(context["title"])
                page.find("id", "Canonical")[0].attrs["href"] = context["canonical"]
    return page


def main():
    from gen.ssg.dispatcher import GenSSGDispatcher

    dispatcher = GenSSGDispatcher()
    api = dispatcher.create_api()
    print(dispatcher.build_page(api, __import__(__name__), CONTEXT(api)))


if __name__ == "__main__":
    main()
