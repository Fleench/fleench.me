<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="alternate" type="application/rss+xml" title="Notes RSS" href="/notes/rss.xml" />
    <script src="/layout.js" defer></script>
    <script src="/mentions.js" defer></script>
  </head>
  <body>
    <div class="page-wrap">
      <div class="site-layout">
        <div class="center-column">
          <div class="content-shell">
            <nav class="top-nav panel" aria-label="Primary navigation">
              <a href="/">Home</a>
              <a href="/notes/">Notes</a>
            </nav>

            <main class="layout h-entry">
              <section class="content panel note-page">
                <h1>{{ title }}</h1>
                <div class="e-content">{{ content }}</div>
                <p><a class="u-url" href="{{ output }}">Permalink</a></p>
                <time class="dt-published" datetime="{{ date }}">{{ date }}</time>
              </section>

              <section class="main-extras">
                <div id="webmentions"></div>
              </section>
            </main>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
