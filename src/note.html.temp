<!-- meta start -->
<!-- 
template: src/page.html.temp
-->
<!-- meta end -->
<!DOCTYPE html>
<html lang="en">
  <head>
    ~{src/.elements/head.element}~
    <link rel="alternate" type="application/rss+xml" title="Notes RSS" href="/notes/rss.xml" />
  </head>
  <body>
    <div class="page-wrap">
      ~{src/.elements/marquee.element}~
      <div class="site-layout">
        <div class="center-column">
          <div class="content-shell">
            ~{src/.elements/nav.element}~

            <main class="layout h-entry">
              <section class="content panel note-page">
                <h1>{{ title }}</h1>
                <div class="e-content">
                  {{ content }}
                  <a class="bridgy-fed-webping" href="https://fed.brid.gy/">Bridgy Fed</a>
                </div>
                <p><a class="u-url" href="{{ output }}">Permalink</a></p>
                <time class="dt-published" datetime="{{ date }}">{{ date }}</time>
                <div style="display:none;">
                                    <a class="u-url p-name" href="/">Home</a>
                                    <div class="p-author h-card">
                                      <a class="u-url n" href="https://flench.me">Flench04</a>
                                      <img class="u-photo" src="/profile.png"/>
                                    </div>
                                  </div>
              </section>
				
              <section class="main-extras">
                <div id="webmentions"></div>
              </section>
            </main>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
