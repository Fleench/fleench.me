from gen.html.elements import Element, Page, Text
from gen.html.parser import GenHTMLParser


BODY = """Greetings
I am Flench04. The webmaster for the Void. I am College Student from Colorado and my pronouns are he/him. I am currently studying computer science and hope to go into video games.

In my free time I love to create video games and play them. Most recently I've been playing Idle Breakout. I'm currently at Level 25531 on my 7th prestige.

I am also Catholic and believe in respecting the human dignity in all forms.

If you have any questions feel free to ask by sending a webmention to this page.
P.S if you are on mobile then remove the m. in the url before sending the webmention."""


def CONTEXT(api):
    return {
        "cache": {"mode": "templates", "templates": ["elements/head", "elements/marquee", "elements/nav", "templates/default", "elements/footer", "templates/page"]},
        "route": "/about/",
        "title": "About",
        "canonical": "https://flench.me/about/",
    }


def Build(api, context):
    fragment = api["methods"]["fragment"]
    markdown = api["methods"]["markdown"]
    parser = GenHTMLParser()
    parsed = parser.parse_text(f"<div>{markdown(BODY)}</div>")

    page = Page("html", {"lang": "en"})
    with page:
        Element("head")
        with Element("body"):
            page_wrap = fragment("templates/page")
            page.add_before(page.find("class", "site-layout")[0].uuid, fragment("elements/marquee"))
            with page_wrap:
                fragment("elements/head")
                fragment("elements/nav")
                template = fragment("templates/default")
                template.find("id", "content_block")[0].attrs["gHoist"] = "ContentPanel"
                template.find("id", "Content")[0].attrs["id"] = "DefaultContent"
                with Element("div", {"gHoist": "DefaultContent"}) as content:
                    for child in list(parsed.children):
                        child.parent = None
                        content.add(child)
                with Element("div", {"style": "display:none;"}):
                    api["methods"]["foot"]()
                with page.find("tag", "title")[0]:
                    Text(context["title"])
                page.find("id", "Canonical")[0].attrs["href"] = context["canonical"]
    return page


def main():
    from gen.ssg.dispatcher import GenSSGDispatcher

    dispatcher = GenSSGDispatcher()
    api = dispatcher.create_api()
    print(dispatcher.build_page(api, __import__(__name__), CONTEXT(api)))


if __name__ == "__main__":
    main()
