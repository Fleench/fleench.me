from gen.html.elements import Element, Page, Text
from gen.html.parser import GenHTMLParser


BODY = """# Welcome
Leave note for the site by sending a web mention to [https://flench.me/guestbook](https://flench.me/guestbook)

Or use the atabook guestbook below."""


def CONTEXT(api):
    return {
        "cache": {"mode": "templates", "templates": ["elements/head", "elements/marquee", "elements/nav", "templates/guestbook", "elements/footer", "templates/page"]},
        "route": "/guestbook/",
        "title": "Guestbook",
        "canonical": "https://flench.me/guestbook/",
    }


def Build(api, context):
    fragment = api["methods"]["fragment"]
    markdown = api["methods"]["markdown"]
    parser = GenHTMLParser()
    parsed = parser.parse_text(f"<div>{markdown(BODY)}</div>")

    page = Page("html", {"lang": "en"})
    with page:
        Element("head")
        with Element("body"):
            page_wrap = fragment("templates/page")
            page.add_before(page.find("class", "site-layout")[0].uuid, fragment("elements/marquee"))
            with page_wrap:
                fragment("elements/head")
                fragment("elements/nav")
                template = fragment("templates/guestbook")
                for head_extra in template.find("id", "head_extra"):
                    for child in list(head_extra.children):
                        head_extra.children.remove(child)
                        child.parent = None
                        child.attrs["gHoist"] = "head"
                        template.add(child)
                    head_extra.parent.children.remove(head_extra)
                template.find("id", "left_sidebar")[0].attrs["gHoist"] = "left-sidebar"
                template.find("id", "right_sidebar")[0].attrs["gHoist"] = "right-sidebar"
                template.find("id", "content_block")[0].attrs["gHoist"] = "ContentPanel"
                template.find("id", "Content")[0].attrs["id"] = "GuestbookContent"
                with Element("div", {"gHoist": "GuestbookContent"}) as content:
                    for child in list(parsed.children):
                        child.parent = None
                        content.add(child)
                with Element("div", {"style": "display:none;"}):
                    api["methods"]["foot"]()
                with page.find("tag", "title")[0]:
                    Text(context["title"])
                page.find("id", "Canonical")[0].attrs["href"] = context["canonical"]
    return page


def main():
    from gen.ssg.dispatcher import GenSSGDispatcher

    dispatcher = GenSSGDispatcher()
    api = dispatcher.create_api()
    api["methods"]["log"]("info", "build", dispatcher.build_page(api, __import__(__name__), CONTEXT(api)))


if __name__ == "__main__":
    main()
