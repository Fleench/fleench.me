              </main>
<aside class="sidebar sidebar-left panel" id="right-sidebar">
  {{ right sidebar }} </aside>
            </div>
          </div>
        </div>
      </div>
    </div>
  <script>
  // window.onload ensures the script waits for all images and CSS to load
  window.onload = function() {
    const grid = document.querySelector(".crow");

    if (!grid) {
      console.error("Shuffle Error: Could not find a container with class '.cow'");
      return;
    }

    // Convert children to a true Array
    const items = Array.from(grid.children);

    if (items.length < 2) {
      console.warn("Shuffle Warning: Not enough items in '.cow' to shuffle.");
      return;
    }

    // Fisher-Yates Shuffle
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }

    // Detach and Re-attach in new order
    grid.innerHTML = "";
    items.forEach(item => {
      grid.appendChild(item);
    });
    grid.style.visibility = "visible";
    console.log("Shuffle Complete! New order applied to .cow grid.");
  };
</script>
  </body>
</html>
