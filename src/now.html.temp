<!DOCTYPE html>
<html lang="en">
  <head>
    ~{src/.elements/head.element}~
    <link rel="alternate" type="application/rss+xml" title="Site RSS" href="/rss.xml" />
  </head>
  <style>
  .fav {
    position: relative;
    width: 16em;
    margin: 0;
    padding: 0;
    background-size: cover;
    overflow: hidden;
  }
  .fav img {
    object-fit: cover;
    width: 100%;
    height: 15em;
    display: block;
   }
  .fav h1 {
    position: absolute;
    bottom: -0.6em;
    text-wrap: auto;
      margin-top: -1.9em;
      font-size: clamp(0.5rem, 2vw, 1rem);
  }
  .fav .ricon {
    position: absolute;
    right: 0;
    z-index: 2;
  }

  .fav[data-href] {
    cursor: pointer;
  }
  .fav .fav-cta {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0;
    transition: opacity 180ms ease-in-out;
    pointer-events: none;
    z-index: 1;
  }

  .fav:hover .fav-cta,
  .fav:focus-visible .fav-cta {
    opacity: 1;
  }
  .ricon img {
  /* This overrides the .fav img styles for the icon specifically */
  width: 32px !important;
  height: 32px !important;
  margin: 0 !important;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
}

.ricon:hover {
    transform: scale(1.1);
}
.crow {
    display: grid;
    grid-template-columns: repeat(auto-fill, 16em);
    overflow: scroll;
    scrollbar-width: none;
    gap: 0;
    margin: 0;
    padding: 0;
    visibility: hidden;
    justify-content: start;
    border-radius: 8px;
}
  </style>
