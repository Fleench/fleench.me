<!DOCTYPE html>
<html lang="en">
  <head>
    ~{src/.elements/head.element}~
    <link rel="alternate" type="application/rss+xml" title="Site RSS" href="/rss.xml" />
  </head>
  <style>
  .fav {
    position: relative;
    width: 16em;
    /*height: 20em;*/
    background-size: cover;
  }
  .fav img {
    object-fit: cover;
    width: 100%;
    height: 15em;
   }
  .fav h1 {
    position: absolute;
    bottom: -0.6em;
    text-wrap: nowrap;
      margin-top: -1.9em;
      font-size: clamp(0.5rem, 2vw, 1rem);
  }
  .fav .ricon {
    position: absolute;
    right: 0;
  }
  .ricon img {
  /* This overrides the .fav img styles for the icon specifically */
  width: 32px !important;
  height: 32px !important;
  margin: 0 !important;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
}

.ricon:hover {
    transform: scale(1.1);
}
.crow {
    display: grid;
    grid-template-columns: repeat(auto-fill, 16em);
    overflow: scroll;
    scrollbar-width: none;
    gap: 0;
    visibility: hidden;
}
  </style>
  <body>
