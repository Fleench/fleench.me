<!DOCTYPE html>
<html lang="en">
  <head>
    ~{src/.elements/head.element}~
    <link rel="alternate" type="application/rss+xml" title="Site RSS" href="/rss.xml" />
  </head>
  <style>
  .fav {
    position: relative;
    width: 16em;
    height: 20em;
    background-size: cover;
      margin: 10px;
      flex-shrink: 0;
  }
  .fav img {
    object-fit: cover;
    width: 100%;
    height: 15em;
   }
  .fav h1 {
    position: relative;
    bottom: 1em;
    text-wrap: nowrap;
  }
  .fav .spicon {
    position: absolute;
    right: 0;
  }
  .spicon img {
  /* This overrides the .fav img styles for the icon specifically */
  width: 32px !important;
  height: 32px !important;
  margin: 0 !important;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
}

.spicon:hover {
    transform: scale(1.1);
}
.crow {
    display: flex;
    flex-direction: row;
    overflow: scroll;
    scrollbar-width: none;
}
  </style>
  <body>
    <div class="page-wrap">
      ~{src/.elements/marquee.element}~

      <div class="site-layout">
        <div class="center-column">
          <div class="content-shell">
            <button
              class="sidebar-toggle-button panel"
              type="button"
              aria-controls="left-sidebar"
              aria-expanded="false"
              hidden
            >
              Toggle sidebar
            </button>

            ~{src/.elements/nav.element}~

            <div class="content-row">
              <aside class="sidebar sidebar-left panel" id="left-sidebar">{{ left sidebar }}</aside>

              <main class="layout h-entry">
                <section class="content panel">
                  <div class="crow">
                  <!-- ben rector-->
                  <div class = "fav">
                      <a href=":{src/.elements/spotify.py}:(Ben Rector,artist,1)" target="_blank" class="spicon">
    <img src="https://storage.googleapis.com/pr-newsroom-wp/1/2023/05/Spotify_Primary_Logo_RGB_Green.png" alt="Listen on Spotify">
  </a>
                    <img src=":{src/.elements/spotify.py}:(Ben Rector,artist)"> </img>
                    <h1>
                      Ben Rector
                    </h1>
                  </div>
                    <!-- Luminati Suns-->
                  <div class = "fav">
<a href=":{src/.elements/spotify.py}:(Luminati Suns,artist,1)" target="_blank" class="spicon">
    <img src="https://storage.googleapis.com/pr-newsroom-wp/1/2023/05/Spotify_Primary_Logo_RGB_Green.png" alt="Listen on Spotify">
  </a>
                    <img src=":{src/.elements/spotify.py}:(Luminati Suns,artist)"> </img>
                    <h1>
                      Luminati Suns
                    </h1>
                  </div>

                    <!-- Josiah Queen-->
                  <div class = "fav">
                      <a href=":{src/.elements/spotify.py}:(Josiah Queen,artist,1)" target="_blank" class="spicon">
    <img src="https://storage.googleapis.com/pr-newsroom-wp/1/2023/05/Spotify_Primary_Logo_RGB_Green.png" alt="Listen on Spotify">
  </a>
                    <img src=":{src/.elements/spotify.py}:(Josiah Queen,artist)"> </img>
                    <h1>
                      Josiah Queen
                    </h1>
                  </div>
                        <!-- Owl City-->
                  <div class = "fav">
                      <a href=":{src/.elements/spotify.py}:(Owl City,artist,1)" target="_blank" class="spicon">
    <img src="https://storage.googleapis.com/pr-newsroom-wp/1/2023/05/Spotify_Primary_Logo_RGB_Green.png" alt="Listen on Spotify">
  </a>
                    <img src=":{src/.elements/spotify.py}:(Owl City,artist)"> </img>
                    <h1>
                      Owl City
                    </h1>
                  </div>
                                      <!-- Mercy Me-->
                  <div class = "fav">
                      <a href=":{src/.elements/spotify.py}:(Mercy Me,artist,1)" target="_blank" class="spicon">
    <img src="https://storage.googleapis.com/pr-newsroom-wp/1/2023/05/Spotify_Primary_Logo_RGB_Green.png" alt="Listen on Spotify">
  </a>
                    <img src=":{src/.elements/spotify.py}:(Mercy Me,artist)"> </img>
                    <h1>
                      Mercy Me
                    </h1>
                  </div>
                  </div>
                  <div class="e-content"> </div>
                  <div style="display:none;">
                    <a class="u-url p-name" href="{{ output }}">{{ title }}</a>
                    <time class="dt-published" datetime="{{ date }}">{{ date }}</time>
                    <div class="p-author h-card">
                      <a class="u-url n" href="https://flench.me">Flench04</a>
                    </div>
                  </div>
                </section>

                <section class="main-extras">
                  <div id="webmentions"></div>
                   ~{src/.elements/footer.element}~
                </section>
              </main>
<aside class="sidebar sidebar-left panel" id="right-sidebar">
  {{ right sidebar }} </aside>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
