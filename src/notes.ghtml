from pathlib import Path

from gen.html.elements import Element, Page, Text
from gen.html.parser import GenHTMLParser


NOTE_ROOT = Path("src/notes")


def _split_frontmatter(text):
    if not text.startswith("---"):
        return {}, text

    parts = text.split("---", 2)
    if len(parts) < 3:
        return {}, text

    meta = {}
    for line in parts[1].splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        meta[key.strip()] = value.strip().strip('"')
    return meta, parts[2].strip()


def _route_for(path):
    rel = path.relative_to(NOTE_ROOT).with_suffix("")
    return f"/notes/{rel.as_posix()}/"


def CONTEXT(api):
    contexts = []
    for md_file in sorted(NOTE_ROOT.glob("**/*.md")):
        meta, _body = _split_frontmatter(md_file.read_text(encoding="utf-8"))
        route = _route_for(md_file)
        title = meta.get("date") or md_file.stem
        contexts.append(
            {
                "route": route,
                "title": title,
                "canonical": f"https://flench.me{route}",
                "MD file": str(md_file),
                "date": meta.get("date", ""),
                "type": meta.get("type", "note"),
                "draft": meta.get("draft", ""),
                "cache": {"mode": "templates", "templates": ["elements/head", "elements/marquee", "elements/nav", "templates/note", "elements/footer", "templates/page"]},
            }
        )
    return contexts


def _html_children(html):
    root = GenHTMLParser().parse_text(f"<div>{html}</div>")
    children = list(root.children)
    for child in children:
        child.parent = None
    return children


def _remove(element):
    if element.parent is not None:
        element.parent.children.remove(element)
        element.parent = None


def _move_head_extra(template):
    for head_extra in template.find("id", "head_extra"):
        for child in list(head_extra.children):
            head_extra.children.remove(child)
            child.parent = None
            child.attrs["gHoist"] = "head"
            template.add(child)
        _remove(head_extra)


def _read_body(md_file):
    _, body = _split_frontmatter(Path(md_file).read_text(encoding="utf-8"))
    return body


def Build(api, context):
    fragment = api["methods"]["fragment"]
    markdown = api["methods"]["markdown"]

    page = Page("html", {"lang": "en"})
    with page:
        Element("head")
        with Element("body"):
            page_wrap = fragment("templates/page")
            page.add_before(page.find("class", "site-layout")[0].uuid, fragment("elements/marquee"))
            with page_wrap:
                fragment("elements/head")
                fragment("elements/nav")

                content_panel = page.find("id", "ContentPanel")[0]
                for child in list(content_panel.children):
                    _remove(child)

                template = fragment("templates/note")
                _move_head_extra(template)
                template.find("id", "left_sidebar")[0].attrs["gHoist"] = "left-sidebar"
                template.find("id", "right_sidebar")[0].attrs["gHoist"] = "right-sidebar"
                template.find("id", "content_block")[0].attrs["gHoist"] = "ContentPanel"
                template.find("id", "Content")[0].attrs["id"] = "NoteContent"
                for main_extras in template.find("id", "main_extras"):
                    _remove(main_extras)

                title = template.find("id", "Title")[0]
                with title:
                    Text(context["title"])

                with Element("div", {"gHoist": "NoteContent"}) as content:
                    for child in _html_children(markdown(_read_body(context["MD file"]))):
                        content.add(child)

                with Element("div", {"style": "display:none;"}):
                    api["methods"]["foot"]()
                with page.find("tag", "title")[0]:
                    Text(context["title"])
                page.find("id", "Canonical")[0].attrs["href"] = context["canonical"]
    return page


def main():
    from gen.ssg.dispatcher import GenSSGDispatcher

    dispatcher = GenSSGDispatcher()
    api = dispatcher.create_api()
    for context in CONTEXT(api):
        print(dispatcher.build_page(api, __import__(__name__), context))


if __name__ == "__main__":
    main()
