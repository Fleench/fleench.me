from pathlib import Path

from gen.html.elements import Element, Page, Text


SOURCE = Path("src/index.md")


def _split_frontmatter(text):
    if not text.startswith("---"):
        return {}, text
    parts = text.split("---", 2)
    if len(parts) < 3:
        return {}, text
    meta = {}
    for line in parts[1].splitlines():
        if ":" not in line:
            continue
        key, value = line.split(":", 1)
        meta[key.strip()] = value.strip().strip('"').strip("'")
    return meta, parts[2].strip()


def CONTEXT(api):
    return {
        "route": "/",
        "title": "The Void",
        "canonical": "https://flench.me/",
    }


def Build(api, context):
    fragment = api["methods"]["fragment"]
    gen_md = api["methods"]["genMD"]
    _meta, body = _split_frontmatter(SOURCE.read_text(encoding="utf-8"))
    blocks = gen_md(body, ghoist="Content")
    for block in blocks:
        if block.attrs.get("gHoist") == "button":
            block.attrs["gHoist"] = "Button"

    page = Page("html", {"lang": "en"})
    with page:
        Element("head")
        with Element("body"):
            page_wrap = fragment("templates/page")
            page.add_before(
                page.find("class", "site-layout")[0].uuid,
                fragment("elements/marquee"),
            )
            with page_wrap:
                fragment("elements/head")
                fragment("elements/nav")
                index_template = fragment("templates/index")
                for block in blocks:
                    index_template.add(block)
                with Element("div", {"style": "display:none;"}):
                    api["methods"]["foot"]()
                title = page.find("tag", "title")[0]
                with title:
                    Text(context["title"])
                page.find("id", "Canonical")[0].attrs["href"] = context["canonical"]
    return page


def main():
    from gen.ssg.dispatcher import GenSSGDispatcher

    dispatcher = GenSSGDispatcher()
    api = dispatcher.create_api()
    print(dispatcher.build_page(api, __import__(__name__), CONTEXT(api)))


if __name__ == "__main__":
    main()
