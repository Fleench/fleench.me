<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <link rel="stylesheet" href="style.css" />

    <script src="mentions.js"></script>
  </head>
  <body>
    <div class="page-wrap">
      <header class="marquee-frame">
        <marquee behavior="alternate" scrollamount="6">
          ★ Welcome to Retro Pixel Palace ★ Midnight Edition ★
        </marquee>
      </header>

      <div class="site-layout">
        <div class="center-column">
          <div class="content-shell">
            <input
              class="sidebar-toggle-input"
              type="checkbox"
              id="sidebar-toggle"
              aria-controls="left-sidebar"
            />
            <label class="sidebar-toggle-button panel" for="sidebar-toggle">
              Toggle sidebar
            </label>

            <nav class="top-nav panel top-nav-main">{{ nav bar }}</nav>

            <div class="content-row">
              <aside class="sidebar sidebar-left panel" id="left-sidebar">{{ left sidebar }}</aside>

              <main class="layout h-entry">
                <section class="content panel">
                  <div class="e-content">{{ content }}</div>
                  <div style="display:none;">
                    <a class="u-url p-name" href="{{ output }}">{{ title }}</a>
                    <time class="dt-published" datetime="{{ date }}">{{ date }}</time>
                    <div class="p-author h-card">
                      <a class="u-url n" href="https://flench.me">Glenn Sutherland</a>
                    </div>
                  </div>
                  </section>
              </main>
            </div>
          </div>

          <div class="main-only-block">
            <div id="webmentions"></div>
            <script src="mentions.js"></script>
            <footer class="panel footer">
              <p>© 2001 Retro Pixel Palace — E-mail: webmaster@pixelpalace.example</p>
            </footer>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
