from gen.html.elements import Element, Page, Text


def CONTEXT(api):
    return {
        "cache": {"mode": "templates", "templates": ["templates/replace"]},
        "route": "/do-not-link/now/",
        "title": "Redirect",
        "canonical": "https://flench.me/do-not-link/now/",
        "hidden": True,
    }


def Build(api, context):
    fragment = api["methods"]["fragment"]

    page = Page("html", {"lang": "en"})
    with page:
        with Element("head"):
            with Element("title"):
                Text(context["title"])
        with Element("body"):
            redirect = fragment("templates/replace")
            redirect.attrs["data-location"] = "/now"
    return page


def main():
    from gen.ssg.dispatcher import GenSSGDispatcher

    dispatcher = GenSSGDispatcher()
    api = dispatcher.create_api()
    api["methods"]["log"]("info", "build", "Built page")


if __name__ == "__main__":
    main()
