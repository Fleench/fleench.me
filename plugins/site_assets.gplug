def _queue_site_assets(api):
    asset_copy = api["methods"]["asset_copy"]
    for asset in SITE_ASSETS:
        asset_copy(asset, asset)
    for asset in MOBILE_ASSET_DESTINATIONS:
        asset_copy(asset, f"mobile/{asset}")


def API(api):
    api["register"]["pre_build"](_queue_site_assets)
    return api


def HELP():
    return """Plugin: site_assets

Description:
  Queues this site's static assets through assets.asset_copy so current dist
  paths match the legacy static asset locations.
"""
