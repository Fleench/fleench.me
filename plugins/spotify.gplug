from urllib.parse import quote_plus

try:
    import spotipy
    from spotipy.oauth2 import SpotifyClientCredentials
except Exception:
    spotipy = None
    SpotifyClientCredentials = None


MANIFEST = {
    "name": "spotify",
    "priority": 999,
    "depends": ["config"],
}


FALLBACK_IMAGE = "/profile.png"


def _config(api, key, default=None):
    lookup = api.get("methods", {}).get("config")
    value = lookup(key) if callable(lookup) else None
    return default if value is None else value


def _fallback_image(api):
    return str(_config(api, "spotify.fallback_image", FALLBACK_IMAGE))


def _fallback_value(api, search_query, item_type, return_playback):
    if return_playback:
        return f"https://open.spotify.com/search/{quote_plus(str(search_query))}"
    return _fallback_image(api)


def _get_spotify_credentials(api):
    client_id = (
        _config(api, "spotify.client_id")
        or _config(api, "secrets.spotify.client_id")
        or _config(api, "secrets.SPOTIFY_CLIENT_ID")
    )
    client_secret = (
        _config(api, "spotify.client_secret")
        or _config(api, "secrets.spotify.client_secret")
        or _config(api, "secrets.SPOTIFY_CLIENT_SECRET")
    )
    return client_id, client_secret


def _spotify(api, search_query="", item_type="artist", return_playback=False):
    search_query = str(search_query)
    raw_item_type = str(item_type)
    return_playback = str(return_playback) == "1" or return_playback is True

    normalized_type = raw_item_type.lower()
    is_id_lookup = False
    if normalized_type.endswith("id"):
        item_type = normalized_type[:-2]
        is_id_lookup = True
    elif normalized_type.startswith("id"):
        item_type = normalized_type[2:]
        is_id_lookup = True
    else:
        item_type = normalized_type

    if item_type not in ["artist", "album", "track"]:
        return _fallback_value(api, search_query, item_type, return_playback)

    client_id, client_secret = _get_spotify_credentials(api)
    if not client_id or not client_secret or spotipy is None or SpotifyClientCredentials is None:
        return _fallback_value(api, search_query, item_type, return_playback)

    try:
        auth_manager = SpotifyClientCredentials(client_id=client_id, client_secret=client_secret)
        sp = spotipy.Spotify(auth_manager=auth_manager)
    except Exception:
        return _fallback_value(api, search_query, item_type, return_playback)

    try:
        if is_id_lookup:
            if item_type == "artist":
                item_data = sp.artist(search_query)
            elif item_type == "album":
                item_data = sp.album(search_query)
            else:
                item_data = sp.track(search_query)
        else:
            results = sp.search(q=f"{item_type}:{search_query}", type=item_type, limit=1)
            items = results.get(f"{item_type}s", {}).get("items", [])
            if not items:
                return _fallback_value(api, search_query, item_type, return_playback)
            item_data = items[0]

        if return_playback:
            url = item_data.get("external_urls", {}).get("spotify")
            return url if url else _fallback_value(api, search_query, item_type, return_playback)

        images = item_data.get("album", {}).get("images", []) if item_type == "track" else item_data.get("images", [])
        if images:
            return images[0]["url"]
        return _fallback_value(api, search_query, item_type, return_playback)
    except Exception:
        return _fallback_value(api, search_query, item_type, return_playback)


def API(api):
    api["register"]["method"]("spotify", lambda *args, **kwargs: _spotify(api, *args, **kwargs))
    return api


def HELP():
    return """Plugin: spotify

Usage:
  api["methods"]["spotify"]("Ben Rector", "artist")
  api["methods"]["spotify"]("Ben Rector", "artist", True)
  api["methods"]["spotify"]("5AfoxZl8Y5VJgC9nK0DvBV", "albumID")

Description:
  Returns a Spotify image URL by default, or a playback/search URL when the
  third argument is true or "1".

Config:
  spotify.fallback_image: /profile.png

Credentials:
  Spotify only reads credentials through config.gplug:
  spotify.client_id / spotify.client_secret
  secrets.spotify.client_id / secrets.spotify.client_secret
  secrets.SPOTIFY_CLIENT_ID / secrets.SPOTIFY_CLIENT_SECRET

  config.gplug loads gen.yaml, project-root .env, project-root local.env, and
  system environment variables for secrets values.
"""


COMMANDS = {}
